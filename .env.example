# DriveSure – copy to .env in this folder (project root)

GROQ_API_KEY=gsk_your_key_here

# Text model (your logs: openai/gpt-oss-20b works)
GROQ_MODEL=openai/gpt-oss-20b

# Vision model for damage + garage bill images (needs vision access on Groq)
# If this 404s, app falls back to text model + EXIF + RAG only
GROQ_VISION_MODEL=qwen/qwen3.8-27b
